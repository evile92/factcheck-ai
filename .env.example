# ==========================================
# FactCheck AI — Environment Configuration
# ==========================================
# All services operate with built-in free/open providers when API keys are not provided.
# Provide keys below to enable premium rate limits and expanded coverage.

# Optional: Google Fact Check Tools API Key
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_FACT_CHECK_API_KEY=

# Optional: NewsAPI Key
# Get one at: https://newsapi.org
NEWS_API_KEY=

# Optional: Bing / Azure Web Search API Key
BING_SEARCH_API_KEY=

# Optional: OpenAI API Key (for secondary semantic summarization fallback)
OPENAI_API_KEY=

# System Settings
PORT=3000
NODE_ENV=development
MAX_FILE_SIZE_MB=50
CACHE_TTL_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
